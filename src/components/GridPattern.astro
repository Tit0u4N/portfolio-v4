---
import { cn } from '@lib/utils';

type Props = {
	width?: number;
	height?: number;
	x?: number;
	y?: number;
	strokeDasharray?: string;
	class?: string;
};

const {
	width = 40,
	height = 40,
	x = -1,
	y = -1,
	strokeDasharray = '0',
	class: className,
} = Astro.props;
const id = 'grid-pattern';
---

<svg
	aria-hidden="true"
	class={cn(
		'pointer-events-none absolute inset-0 h-full w-full fill-gray-400/30 stroke-gray-400/30',
		className,
	)}
>
	<defs>
		<pattern {id} {width} {height} patternUnits="userSpaceOnUse" {x} {y}>
			<path
				d={`M.5 ${height}V.5H${width}`}
				fill="none"
				stroke-dasharray={strokeDasharray}
			></path>
		</pattern>
	</defs>
	<rect width="100%" height="100%" stroke-width="0" fill={`url(#${id})`}></rect>
</svg>
