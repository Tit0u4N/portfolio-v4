---
import Container from '@/components/Container.astro';
import ContainerTitle from '@/components/ContainerTitle.astro';
import ProjectGrid, {
	type ProjectData,
} from '@/components/islands/ProjectGrid';
import { getLocalized, imageUrl } from '@lib/content';
import { ALL_TECH } from '@/data/technologies';
import { useTranslations, type Locale } from '@/i18n/ui';

type Props = { index: number; delay: number; locale: Locale };
const { index, delay, locale } = Astro.props;
const t = useTranslations(locale).projects;

const entries = await getLocalized('projects', locale);
const projects: ProjectData[] = await Promise.all(
	entries.map(async ({ data, rendered }) => ({
		title: data.title,
		shortDescription: data.shortDescription,
		image: await imageUrl(data.image, 1000),
		techs: data.techs.map((key) => ALL_TECH[key]),
		linkGithub: data.linkGithub,
		linkDemo: data.linkDemo,
		html: rendered?.html ?? '',
	})),
);
---

<Container index={index} delay={delay} class="sm:px-4" id="projects">
	<ContainerTitle class="px-2 sm:px-4">{t.title}</ContainerTitle>
	<ProjectGrid
		client:visible
		delay={delay}
		projects={projects}
		labels={{
			links: t.links,
			linkGit: t.linkGit,
			linkDemo: t.linkDemo,
			technologies: t.technologies,
			close: t.close,
		}}
	/>
</Container>
