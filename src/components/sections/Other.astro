---
import Container from '@/components/Container.astro';
import ContainerTitle from '@/components/ContainerTitle.astro';
import { GithubLogo, LinkedinIcon, MailIcon } from '@/components/ui/icons';
import { PROFILE, useTranslations, type Locale } from '@/i18n/ui';

type Props = { index: number; locale: Locale };
const { index, locale } = Astro.props;
const t = useTranslations(locale).other;

const links = [
	{ href: PROFILE.githubLink, label: PROFILE.github, icon: 'github' },
	...(PROFILE.mail
		? [{ href: `mailto:${PROFILE.mail}`, label: PROFILE.mail, icon: 'mail' }]
		: []),
	{ href: PROFILE.linkdinLink, label: PROFILE.linkdin, icon: 'linkedin' },
] as const;
---

<Container index={index} class="mb-4" id="contact">
	<ContainerTitle>{t.title}</ContainerTitle>
	<div class="flex gap-6">
		<address class="flex flex-col gap-2 ms-3 not-italic">
			{links.map(({ href, label, icon }) => (
				<a
					href={href}
					class="flex space-x-2"
					target="_blank"
					rel="noopener noreferrer"
				>
					{icon === 'github' && (
						<GithubLogo className="fill-foreground size-6" />
					)}
					{icon === 'mail' && <MailIcon />}
					{icon === 'linkedin' && <LinkedinIcon />}
					<div>{label}</div>
				</a>
			))}
		</address>
	</div>
</Container>
