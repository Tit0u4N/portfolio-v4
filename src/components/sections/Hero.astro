---
import { Image } from 'astro:assets';
import Container from '@/components/Container.astro';
import ContainerTitle from '@/components/ContainerTitle.astro';
import Logo from '@/components/ui/Logo.astro';
import profileImage from '@/assets/images/profile-image.png';
import { PROFILE, useTranslations, type Locale } from '@/i18n/ui';

type Props = { index: number; locale: Locale };
const { index, locale } = Astro.props;
const t = useTranslations(locale).hero;
const [firstName, lastName] = PROFILE.name.split(' ');
---

<Container index={index} class="flex flex-col max-md:px-3" id="about">
	<div class="grid grid-cols-[1fr_auto] items-center gap-x-8">
		<Logo
			animated
			class="w-24 md:w-28 col-start-1 row-start-1 md:col-span-2 md:justify-self-center md:mb-12"
		/>
		<Image
			src={profileImage}
			alt={PROFILE.name}
			width={140}
			densities={[1, 2]}
			loading="eager"
			fetchpriority="high"
			class="rounded-full col-start-2 row-start-1 md:row-start-2 max-md:size-24"
		/>
		<div class="col-span-2 md:col-span-1 col-start-1 row-start-2 max-md:mt-8">
			<h1 class="mb-4 text-4xl font-medium tracking-[-0.02em]">
				{firstName} <span class="whitespace-nowrap">{lastName}</span>
			</h1>
			<p class="text-xl font-light text-paragraph">{t.callOut}</p>
		</div>
	</div>
	<div class="w-auto">
		<ContainerTitle cursor={false} class="md:mt-20 mt-10 text-xl mb-4">
			{t.about}
		</ContainerTitle>
		<p class="font-light text-paragraph text-justify hyphens-auto">
			{t.description}
		</p>
	</div>
</Container>
