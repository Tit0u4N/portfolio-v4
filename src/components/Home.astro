---
import Hero from '@/components/sections/Hero.astro';
import Timeline from '@/components/sections/Timeline.astro';
import Projects from '@/components/sections/Projects.astro';
import Skills from '@/components/sections/Skills.astro';
import Other from '@/components/sections/Other.astro';
import type { Locale } from '@/i18n/ui';

type Props = { locale: Locale };
const { locale } = Astro.props;
---

<main class="flex flex-col justify-end items-center min-h-[100vh] pb-28">
	<Hero index={0} locale={locale} />
	<Timeline index={1} locale={locale} collection="experiences" />
	<Timeline index={2} locale={locale} collection="education" />
	<Projects index={3} locale={locale} />
	<Skills index={4} locale={locale} />
	<Other index={5} locale={locale} />
</main>
