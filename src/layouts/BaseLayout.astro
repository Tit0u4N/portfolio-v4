---
import '@/styles/global.css';
import fontUrl from '@fontsource-variable/funnel-sans/files/funnel-sans-latin-wght-normal.woff2?url';
import GridPattern from '@/components/GridPattern.astro';
import SEO from '@/components/SEO.astro';
import Nav from '@/components/islands/Nav';
import {
	localePath,
	otherLocale,
	useTranslations,
	type Locale,
} from '@/i18n/ui';

type Props = {
	locale: Locale;
	title?: string;
	description?: string;
	noindex?: boolean;
};
const { locale, noindex } = Astro.props;
const t = useTranslations(locale);
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Theme before first paint (same storage key/behaviour as next-themes in v3) -->
		<script is:inline>
			(() => {
				let stored = null;
				try {
					stored = localStorage.getItem('theme');
				} catch {}
				const dark =
					stored === 'dark' ||
					((!stored || stored === 'system') &&
						matchMedia('(prefers-color-scheme: dark)').matches);
				document.documentElement.classList.toggle('dark', dark);
				document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
			})();
		</script>
		<link
			rel="preload"
			href={fontUrl}
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="color-scheme" content="light dark" />
		<SEO
			locale={locale}
			title={title}
			description={description}
			noindex={noindex}
		/>
	</head>
	<body>
		<GridPattern
			width={40}
			height={40}
			x={-1}
			y={-1}
			strokeDasharray="4 2"
			class="sm:[mask-image:radial-gradient(60vw_circle_at_center,white,transparent)] fixed"
		/>
		<Nav
			client:load
			locale={locale}
			alternateHref={localePath(otherLocale(locale))}
		/>
		<slot />
		<!-- Marks the current section: its cursor blinks (see global.css).
		     The reading line slides down the viewport so the last, short section can win. -->
		<script is:inline>
			(() => {
				const sections = [...document.querySelectorAll('section[id]')];
				let active = null;
				let queued = false;
				const update = () => {
					queued = false;
					const max = document.documentElement.scrollHeight - innerHeight;
					const progress = max > 0 ? Math.min(scrollY / max, 1) : 0;
					const line = innerHeight * (0.3 + 0.7 * progress);
					const next =
						sections.findLast((s) => s.getBoundingClientRect().top <= line) ??
						sections[0];
					if (next === active) return;
					active?.removeAttribute('data-active');
					next?.setAttribute('data-active', '');
					active = next;
				};
				const queue = () => {
					if (queued) return;
					queued = true;
					requestAnimationFrame(update);
				};
				addEventListener('scroll', queue, { passive: true });
				addEventListener('resize', queue, { passive: true });
				update();

				// Logo hover loop: on leave, it finishes its cycle instead of snapping back
				document.querySelectorAll('.logo-loop').forEach((logo) => {
					const zone = logo.closest('a') ?? logo;
					let hovered = false;
					zone.addEventListener('pointerenter', (e) => {
						if (e.pointerType === 'touch') return;
						hovered = true;
						logo.classList.add('is-looping');
					});
					zone.addEventListener('pointerleave', () => {
						hovered = false;
					});
					logo.addEventListener('animationiteration', (e) => {
						if (!hovered && e.animationName === 'logo-loop-cursor')
							logo.classList.remove('is-looping');
					});
				});
			})();
		</script>
	</body>
</html>
