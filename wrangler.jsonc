{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio-v4",
	"compatibility_date": "2026-10-01",
	// Assets-only Worker: no script, Cloudflare serves ./dist from the edge.
	// Headers (CSP, cache) come from dist/_headers, generated by scripts/postbuild.mjs
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	},
	"observability": { "enabled": true },
	// Canonical host is the apex. www.titouanlf.com → 301 via a Cloudflare Redirect Rule (see README)
	"routes": [{ "pattern": "titouanlf.com", "custom_domain": true }]
}
